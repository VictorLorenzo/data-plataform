# Unity Catalog as the single catalog implementation
spark.sql.catalog.datalake_uc=io.unitycatalog.spark.UCSingleCatalog
spark.sql.catalog.datalake_uc.uri=http://unity-catalog-server:8080
spark.sql.catalog.datalake_uc.token=
spark.sql.defaultCatalog=datalake_uc

spark.sql.catalog.spark_catalog=org.apache.spark.sql.delta.catalog.DeltaCatalog

spark.jars=/home/airflow/spark-jars/delta-spark_2.12-3.2.1.jar,/home/airflow/spark-jars/delta-storage-3.2.1.jar,/home/airflow/spark-jars/antlr4-runtime-4.9.3.jar,/home/airflow/spark-jars/hadoop-aws-3.3.4.jar,/home/airflow/spark-jars/aws-java-sdk-bundle-1.12.262.jar,/home/airflow/spark-jars/spark-avro_2.12-3.5.3.jar,/home/airflow/spark-jars/unitycatalog-spark_2.12-0.2.1.jar,/home/airflow/spark-jars/unitycatalog-client-0.2.1.jar,/home/airflow/spark-jars/delta-iceberg_2.12-3.2.1.jar
spark.hadoop.fs.s3a.access.key=<R2_ACCESS_KEY_ID>
spark.hadoop.fs.s3a.secret.key=<R2_SECRET_ACCESS_KEY>
spark.hadoop.fs.s3a.path.style.access=true
spark.hadoop.fs.s3a.impl=org.apache.hadoop.fs.s3a.S3AFileSystem
spark.hadoop.fs.s3.impl=org.apache.hadoop.fs.s3a.S3AFileSystem
spark.hadoop.fs.s3a.endpoint=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
spark.hadoop.fs.s3.endpoint=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
spark.hadoop.fs.s3a.connection.ssl.enabled=true
spark.hadoop.fs.s3.access.key=<R2_ACCESS_KEY_ID>
spark.hadoop.fs.s3.secret.key=<R2_SECRET_ACCESS_KEY>
spark.hadoop.fs.s3.path.style.access=true
spark.hadoop.fs.s3.connection.ssl.enabled=true
spark.hadoop.fs.s3a.aws.credentials.provider=org.apache.hadoop.fs.s3a.SimpleAWSCredentialsProvider
spark.hadoop.fs.s3a.bucket.datalake-landing.access.key=<R2_ACCESS_KEY_ID>
spark.hadoop.fs.s3a.bucket.datalake-landing.secret.key=<R2_SECRET_ACCESS_KEY>
spark.hadoop.fs.s3a.bucket.datalake-landing.endpoint=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
spark.hadoop.fs.s3a.bucket.datalake-landing.path.style.access=true
spark.hadoop.fs.s3a.bucket.datalake-landing.connection.ssl.enabled=true
spark.hadoop.fs.s3a.bucket.datalake-bronze.access.key=<R2_ACCESS_KEY_ID>
spark.hadoop.fs.s3a.bucket.datalake-bronze.secret.key=<R2_SECRET_ACCESS_KEY>
spark.hadoop.fs.s3a.bucket.datalake-bronze.endpoint=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
spark.hadoop.fs.s3a.bucket.datalake-bronze.path.style.access=true
spark.hadoop.fs.s3a.bucket.datalake-bronze.connection.ssl.enabled=true
spark.hadoop.fs.s3a.bucket.datalake-silver.access.key=<R2_ACCESS_KEY_ID>
spark.hadoop.fs.s3a.bucket.datalake-silver.secret.key=<R2_SECRET_ACCESS_KEY>
spark.hadoop.fs.s3a.bucket.datalake-silver.endpoint=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
spark.hadoop.fs.s3a.bucket.datalake-silver.path.style.access=true
spark.hadoop.fs.s3a.bucket.datalake-silver.connection.ssl.enabled=true
spark.hadoop.fs.s3a.bucket.datalake-gold.access.key=<R2_ACCESS_KEY_ID>
spark.hadoop.fs.s3a.bucket.datalake-gold.secret.key=<R2_SECRET_ACCESS_KEY>
spark.hadoop.fs.s3a.bucket.datalake-gold.endpoint=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
spark.hadoop.fs.s3a.bucket.datalake-gold.path.style.access=true
spark.hadoop.fs.s3a.bucket.datalake-gold.connection.ssl.enabled=true
spark.hadoop.fs.s3a.bucket.datalake-uc.access.key=<R2_ACCESS_KEY_ID>
spark.hadoop.fs.s3a.bucket.datalake-uc.secret.key=<R2_SECRET_ACCESS_KEY>
spark.hadoop.fs.s3a.bucket.datalake-uc.endpoint=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
spark.hadoop.fs.s3a.bucket.datalake-uc.path.style.access=true
spark.hadoop.fs.s3a.bucket.datalake-uc.connection.ssl.enabled=true
spark.sql.extensions=io.delta.sql.DeltaSparkSessionExtension
spark.databricks.delta.schema.autoMerge.enabled=true
spark.sql.warehouse.dir=s3://datalake-uc/warehouse

# Spark Event Logging (for History Server)
spark.eventLog.enabled=true
spark.eventLog.dir=s3a://datalake-landing/spark-events

# Parquet datetime rebase: write Proleptic Gregorian as-is (Spark 3+/Delta readers).
# Required for INMET stations and other datasets with pre-1900 timestamps.
spark.sql.parquet.datetimeRebaseModeInWrite=CORRECTED
spark.sql.parquet.int96RebaseModeInWrite=CORRECTED
spark.sql.avro.datetimeRebaseModeInWrite=CORRECTED

# Delta MERGE memory tuning: prevent driver OOM on broadcast build during MERGE
spark.driver.memory=4g
spark.driver.maxResultSize=2g
spark.sql.autoBroadcastJoinThreshold=-1
spark.sql.shuffle.partitions=50
spark.databricks.delta.merge.repartitionBeforeWrite.enabled=true