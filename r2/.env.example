# Cloudflare R2 credentials
# Copy this file to `.env` and fill the values. The `.env` file is gitignored.
#
# Access Key ID / Secret Access Key: Cloudflare dashboard > R2 > Manage API tokens.
# (The "Token value" shown on that page is for Cloudflare's own management API —
# not used here, since we talk to R2 through the S3-compatible API instead.)
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me

# NOT shown on the token page. Find it on the R2 overview page's right-hand
# sidebar ("Account ID"), or in the dashboard URL:
# https://dash.cloudflare.com/<R2_ACCOUNT_ID>/r2/overview
R2_ACCOUNT_ID=replace-me

# Leave empty unless your data must stay in a specific jurisdiction (matches
# "Use jurisdiction-specific endpoints for S3 clients" in the dashboard).
# Valid values: eu, fedramp
R2_JURISDICTION=
