# Copy this file to `.env` and fill in your Cloudflare R2 credentials (gitignored).
# Used by the spark-history service, which configures its own S3A access via
# inline JVM options instead of reading spark-config/spark-defaults.conf.
R2_ACCOUNT_ID=replace-me
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
